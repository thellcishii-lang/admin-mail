<div class="mx-auto max-w-4xl">
  <p class="mb-3"><%= link_to "← 受信トレイ", emails_path, class: "text-blue-600 hover:underline text-sm" %></p>
  <h1 class="font-bold text-2xl mb-3"><%= @message[:subject] %></h1>
  <dl class="text-sm text-gray-500 mb-5 space-y-1">
    <div>差出人：<%= @message[:from_display] %></div>
    <div>宛先：<%= @message[:to] %></div>
    <div>日時：<%= @message[:date]&.strftime("%Y-%m-%d %H:%M") %></div>
  </dl>

  <div class="flex gap-2 mb-6">
    <%= link_to "返信する", new_email_path(to: @message[:from], subject: "Re: #{@message[:subject]}", body: "\n\n----- 元のメッセージ -----\n#{@message[:body]}"), class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg p-5 whitespace-pre-wrap text-sm leading-relaxed"><%= @message[:body] %></div>
</div>
