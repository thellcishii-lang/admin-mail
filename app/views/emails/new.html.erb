<div class="mx-auto max-w-3xl">
  <h1 class="font-bold text-3xl mb-2">📧 メール個別送信</h1>
  <p class="text-gray-500 text-sm mb-5">任意の宛先へ1件だけ送信できます。問い合わせへの返信などに使います。差出人は <%= ENV["MAIL_FROM"].presence || ENV["INFOMAIL_USER"].presence || "（環境変数で設定）" %> です。</p>

  <% if @email.errors.any? %>
    <div class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-lg">
      <ul><% @email.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
    </div>
  <% end %>

  <%= form_with model: @email, url: emails_path, multipart: true, class: "bg-white border border-gray-200 rounded-lg p-5" do |form| %>
    <div class="my-5">
      <%= form.label :to_address, "宛先", class: "font-medium" %>
      <%= form.email_field :to_address, required: true, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <%= render "template_picker", form: form, templates: @templates %>

    <label class="flex items-center gap-2 text-sm my-3">
      <%= check_box_tag :reply_mode, "1", false, class: "rounded border-gray-400" %>
      返信として送る（件名に Re: を付ける）
    </label>

    <div class="my-5">
      <%= form.label :subject, "件名", class: "font-medium" %>
      <%= form.text_field :subject, required: true, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :body, "本文", class: "font-medium" %>
      <%= form.text_area :body, required: true, rows: 12, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
      <p class="text-gray-500 text-sm mt-1">選んだ様式のヘッダーとフッター（会社情報）が自動で付きます。</p>
    </div>

    <%= render "attachments_field" %>

    <%= form.submit "送信する", class: "rounded-md px-4 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
  <% end %>
</div>
