#!/bin/bash -e

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare

  # db:prepare never seeds, so load the initial operator + templates on
  # first boot only (FirstBootSeeder is a no-op once a user exists).
  if [ "$RUN_SEED_IF_EMPTY" == "true" ]; then
    ./bin/rails runner "FirstBootSeeder.call"
  fi
fi

exec "${@}"
