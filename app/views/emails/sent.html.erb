<div class="mx-auto max-w-5xl">
  <h1 class="font-bold text-3xl mb-5">送信済み</h1>

  <% if @emails.empty? %>
    <p class="text-gray-500">送信済みメールはまだありません。</p>
  <% else %>
    <table class="w-full text-left bg-white text-sm">
      <thead>
        <tr class="border-b border-gray-200 text-gray-500">
          <th class="py-2 pr-4">送信日時</th>
          <th class="py-2 pr-4">様式</th>
          <th class="py-2 pr-4">宛先</th>
          <th class="py-2 pr-4">件名</th>
          <th class="py-2 pr-4">添付</th>
          <th class="py-2"></th>
        </tr>
      </thead>
      <tbody>
        <% @emails.each do |email| %>
          <tr class="border-b border-gray-100 align-top">
            <td class="py-2 pr-4 whitespace-nowrap"><%= email.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            <td class="py-2 pr-4 whitespace-nowrap">
              <% if email.mail_template %>
                <span class="inline-block w-2.5 h-2.5 rounded-full mr-1" style="background-color: <%= email.mail_template.header_color %>"></span><%= email.mail_template.name %>
              <% end %>
              <% if email.batch_id %><span class="text-gray-400">（一斉）</span><% end %>
            </td>
            <td class="py-2 pr-4"><%= email.to_address %></td>
            <td class="py-2 pr-4"><%= email.subject %></td>
            <td class="py-2 pr-4"><%= email.attachment_name_list.join("、") %></td>
            <td class="py-2">
              <details>
                <summary class="text-blue-600 cursor-pointer">本文</summary>
                <div class="whitespace-pre-wrap mt-2 p-3 bg-gray-50 rounded"><%= email.body %></div>
              </details>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
