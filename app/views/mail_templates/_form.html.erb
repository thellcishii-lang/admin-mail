<%= form_with model: mail_template, class: "contents" do |form| %>
  <% if mail_template.errors.any? %>
    <div class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-lg">
      <ul><% mail_template.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name, "様式の名前（管理用）" %>
    <%= form.text_field :name, required: true, placeholder: "例: Push-taro（本体）", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :brand_name, "ヘッダーの製品名" %>
    <%= form.text_field :brand_name, required: true, placeholder: "例: Push-taro", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :tagline, "ヘッダーのキャッチコピー" %>
    <%= form.text_field :tagline, placeholder: "例: 店舗向けプッシュ通知", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :header_color, "ヘッダーの色" %>
    <%= form.color_field :header_color, class: "block mt-2 h-10 w-24" %>
  </div>

  <div class="my-5">
    <%= form.label :from_name, "差出人名" %>
    <%= form.text_field :from_name, placeholder: "空欄なら製品名", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :footer_company, "フッターの運営会社" %>
    <%= form.text_field :footer_company, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :footer_address, "フッターの住所" %>
    <%= form.text_field :footer_address, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :footer_email, "フッターのメールアドレス" %>
    <%= form.email_field :footer_email, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :footer_url, "フッターのURL" %>
    <%= form.text_field :footer_url, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :position, "並び順" %>
    <%= form.number_field :position, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="inline">
    <%= form.submit "保存する", class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
  </div>
  <%= link_to "キャンセル", mail_templates_path, class: "ml-3 text-gray-500 hover:underline" %>
<% end %>
