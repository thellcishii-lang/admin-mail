<div class="mx-auto max-w-md">
  <h1 class="font-bold text-3xl mb-5">パスワード変更</h1>

  <%= form_with url: password_change_path, method: :patch, class: "bg-white border border-gray-200 rounded-lg p-5" do |form| %>
    <div class="my-5">
      <%= form.label :current_password, "現在のパスワード" %>
      <%= form.password_field :current_password, required: true, autocomplete: "current-password", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>
    <div class="my-5">
      <%= form.label :password, "新しいパスワード（8文字以上）" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
    </div>
    <%= form.submit "変更する", class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
  <% end %>
</div>
