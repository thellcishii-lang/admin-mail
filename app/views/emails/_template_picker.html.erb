<div class="my-5">
  <p class="font-medium mb-2">どの製品の様式で送るか</p>
  <div class="flex flex-wrap gap-2">
    <% templates.each do |template| %>
      <label class="cursor-pointer">
        <%= form.radio_button :mail_template_id, template.id, class: "peer sr-only" %>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-gray-300 px-3 py-1.5 text-sm peer-checked:border-blue-600 peer-checked:bg-blue-50 peer-checked:text-blue-700 bg-white">
          <span class="inline-block w-2.5 h-2.5 rounded-full" style="background-color: <%= template.header_color %>"></span>
          <%= template.name %>
        </span>
      </label>
    <% end %>
  </div>
</div>
