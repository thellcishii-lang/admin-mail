<div class="mx-auto max-w-5xl">
  <div class="flex items-center justify-between mb-5">
    <h1 class="font-bold text-3xl">受信トレイ</h1>
    <%= link_to "新規メール", new_email_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
  </div>

  <% if @not_configured %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-5 text-sm">
      <p class="font-bold text-yellow-800 mb-1">メールボックスの接続情報が未設定です</p>
      <p class="text-yellow-700">受信トレイを使うには、サーバーの環境変数（IMAP_USER / IMAP_PASS、または INFOMAIL_USER / INFOMAIL_PASS）を設定してください。</p>
    </div>
  <% elsif @error %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-5 text-sm text-red-700"><%= @error %></div>
  <% elsif @messages.empty? %>
    <p class="text-gray-500">受信トレイにメールはありません。</p>
  <% else %>
    <table class="w-full text-left bg-white">
      <tbody>
        <% @messages.each do |message| %>
          <tr class="border-b border-gray-100 hover:bg-gray-50">
            <td class="py-2.5 pr-2 w-6 text-blue-600"><%= message[:seen] ? "" : "●" %></td>
            <td class="py-2.5 pr-4 w-64 truncate <%= "font-bold" unless message[:seen] %>"><%= message[:from] %></td>
            <td class="py-2.5 pr-4">
              <%= link_to message[:subject], email_path(message[:uid]), class: "text-blue-600 hover:underline #{'font-bold text-gray-900' unless message[:seen]}" %>
            </td>
            <td class="py-2.5 text-right text-sm text-gray-500 whitespace-nowrap"><%= message[:date]&.strftime("%Y-%m-%d %H:%M") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
